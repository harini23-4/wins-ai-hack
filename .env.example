# Local dev (Postgres + pgvector required for vector similarity search):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researcher_matching

# Alternative local dev (SQLite, zero setup — NOTE: vector search will NOT work, use only for basic CRUD testing):
# DATABASE_URL=sqlite:///./dev.db

# Production (Render/Railway will inject this automatically once you attach a Postgres DB):
# DATABASE_URL=postgresql://user:password@host:5432/dbname